; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Canadian Winter"
config/description="Snow-removal business simulator. Survive as many Canadian winters as you can."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Catalog="*res://scripts/autoload/catalog.gd"
Notify="*res://scripts/autoload/notify.gd"
Clock="*res://scripts/autoload/clock.gd"
Weather="*res://scripts/autoload/weather.gd"
Snow="*res://scripts/autoload/snow_sim.gd"
Boxes="*res://scripts/autoload/boxes.gd"
Game="*res://scripts/autoload/game_state.gd"
Economy="*res://scripts/autoload/economy.gd"
Contracts="*res://scripts/autoload/contracts.gd"
Municipal="*res://scripts/autoload/municipal.gd"
Survival="*res://scripts/autoload/survival.gd"
AudioMgr="*res://scripts/autoload/audio_manager.gd"
Saves="*res://scripts/autoload/save_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Canadian Winter"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.42, 0.45, 0.62, 1)

[shader_globals]

snow_cover={
"type": "float",
"value": 0.7
}
night_factor={
"type": "float",
"value": 0.0
}
wind_vec={
"type": "vec2",
"value": Vector2(0.3, 0.1)
}
vm_eye={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
vm_snow_y={
"type": "float",
"value": -1000.0
}
snow_hide_a={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
snow_hide_b={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
snow_hide_c={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
